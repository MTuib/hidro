DATABASE_URL=
JWT_SECRET_KEY=
API_ROOT=http://localhost:8000/hidro
API_USERNAME=
API_PASSWORD=

#Broker
BROKER_URL=pro.iotiblab.uib.cat
BROKER_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
BROKER_TOPIC="hidro/aquifers/#"
#Les sondes publiquen a hidro/aquifers/{ID_SONDA}/dades.

#Django: desenvolupament local. El web usarà el port 8001 a la guia.
DJANGO_ENV=development
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY_HTTPS=0
DJANGO_HSTS_SECONDS=0